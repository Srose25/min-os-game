#----------------------------- Global Properties ----------------------------#
/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

#---------------------------------- Content ---------------------------------#
# Arial is intentionally the version 0 font. The MonoGame processor resolves it from
# the Windows font installation at build time; QA should verify this remains available
# on the developer machine before packaging.
#begin Arial.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/build:Arial.spritefont
